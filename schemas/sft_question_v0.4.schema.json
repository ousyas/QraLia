{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://qralia.local/schemas/sft_question_v0.4.schema.json",
  "type":"object","additionalProperties":false,
  "required":["schema_version","case_id","intent_id","semantic_family_id","language","domain","provider_id","provider_source","channel","register","formulation_kind","question","split","gold_chunk_ids","context_chunk_ids","distractor_chunk_ids","retrieval_outcome","should_abstain","answerable_in_given_context","answerable_in_corpus","generation_provenance","review_status"],
  "properties":{
    "schema_version":{"const":"0.4.0"},
    "case_id":{"type":"string","pattern":"^sftq-v04-[0-9]{4}$"},
    "intent_id":{"type":"string","minLength":1},"semantic_family_id":{"type":"string","minLength":1},
    "language":{"enum":["fr","ar","darija_latn","darija_arab"]},"domain":{"type":"string","minLength":1},"provider_id":{"type":"string","minLength":1},
    "provider_source":{"enum":["explicit_or_alias_in_question","synthetic_invoice_metadata"]},
    "channel":{"const":"typed"},"register":{"enum":["formal","neutral","informal","whatsapp"]},
    "formulation_kind":{"enum":["direct","indirect","contextual_long","provider_implicit","informal_typed"]},
    "question":{"type":"string","minLength":5},"split":{"enum":["train","validation","test"]},
    "gold_chunk_ids":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true,"maxItems":3},
    "context_chunk_ids":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true,"minItems":3,"maxItems":5},
    "distractor_chunk_ids":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true,"minItems":2,"maxItems":5},
    "retrieval_outcome":{"enum":["hit","miss","not_in_corpus"]},"should_abstain":{"type":"boolean"},
    "answerable_in_given_context":{"type":"boolean"},"answerable_in_corpus":{"type":"boolean"},
    "generation_provenance":{"type":"string","minLength":1},"review_status":{"const":"candidate_human_review"}
  }
}
